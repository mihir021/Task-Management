    action_spec {
      command {
        instruction: "Append unit test for mapStatusToBoardColumn, resolveStatusFromBoardColumnDrop, and groupTasksByBoardColumn"
        is_edit: true
        file {
          absolute_uri: "file:///MIHIR/src/lib/workspaceLogic.test.ts"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "  const parsedNumbered = parseAcceptanceCriteriaChecklist(\n    \'1. First check\\n2. Second check\',\n    false\n  );\n  assert.equal(parsedNumbered.length, 2);\n  assert.equal(parsedNumbered[0].title, \'First check\');\n});"
          replacement_content: "  const parsedNumbered = parseAcceptanceCriteriaChecklist(\n    \'1. First check\\n2. Second check\',\n    false\n  );\n  assert.equal(parsedNumbered.length, 2);\n  assert.equal(parsedNumbered[0].title, \'First check\');\n});\n\ntest(\'Board view maps 7 granular statuses into Todo, In Progress, Review, Done and resolves drag-and-drop transitions\', () => {\n  assert.equal(BOARD_WORKFLOW_COLUMNS.length, 4);\n  assert.deepEqual(\n    BOARD_WORKFLOW_COLUMNS.map((c) => c.id),\n    [\'Todo\', \'In Progress\', \'Review\', \'Done\']\n  );\n\n  assert.equal(mapStatusToBoardColumn(\'Backlog\'), \'Todo\');\n  assert.equal(mapStatusToBoardColumn(\'Assigned\'), \'Todo\');\n  assert.equal(mapStatusToBoardColumn(\'In Progress\'), \'In Progress\');\n  assert.equal(mapStatusToBoardColumn(\'Blocked\'), \'In Progress\');\n  assert.equal(mapStatusToBoardColumn(\'Ready for Testing\'), \'Review\');\n  assert.equal(mapStatusToBoardColumn(\'In Review\'), \'Review\');\n  assert.equal(mapStatusToBoardColumn(\'Done\'), \'Done\');\n\n  // Dropping into a new column assigns that column\'s default status\n  assert.equal(resolveStatusFromBoardColumnDrop(\'Todo\', \'In Progress\'), \'Assigned\');\n  assert.equal(resolveStatusFromBoardColumnDrop(\'In Progress\', \'Assigned\'), \'In Progress\');\n  assert.equal(resolveStatusFromBoardColumnDrop(\'Review\', \'In Progress\'), \'In Review\');\n  assert.equal(resolveStatusFromBoardColumnDrop(\'Done\', \'In Review\'), \'Done\');\n\n  // Dropping within the same column preserves the granular status\n  assert.equal(resolveStatusFromBoardColumnDrop(\'Todo\', \'Backlog\'), \'Backlog\');\n  assert.equal(resolveStatusFromBoardColumnDrop(\'In Progress\', \'Blocked\'), \'Blocked\');\n  assert.equal(resolveStatusFromBoardColumnDrop(\'Review\', \'Ready for Testing\'), \'Ready for Testing\');\n\n  const tasks = [\n    createSampleTask({ id: \'t1\', taskCode: \'MIHIR-001\', status: \'Ready for Testing\' }),\n    createSampleTask({ id: \'t2\', taskCode: \'MIHIR-002\', status: \'In Progress\' }),\n    createSampleTask({ id: \'t3\', taskCode: \'MIHIR-003\', status: \'Assigned\' }),\n    createSampleTask({ id: \'t4\', taskCode: \'MIHIR-004\', status: \'Done\' }),\n  ];\n\n  const grouped = groupTasksByBoardColumn(tasks);\n  assert.equal(grouped[\'Todo\'].length, 1);\n  assert.equal(grouped[\'Todo\'][0].taskCode, \'MIHIR-003\');\n  assert.equal(grouped[\'In Progress\'].length, 1);\n  assert.equal(grouped[\'In Progress\'][0].taskCode, \'MIHIR-002\');\n  assert.equal(grouped[\'Review\'].length, 1);\n  assert.equal(grouped[\'Review\'][0].taskCode, \'MIHIR-001\');\n  assert.equal(grouped[\'Done\'].length, 1);\n  assert.equal(grouped[\'Done\'][0].taskCode, \'MIHIR-004\');\n});\n"
          start_line: 280
          end_line: 290
        }
      }
    }
