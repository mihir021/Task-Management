      thinking_signature: "\022\316\t\n\313\t\001i\024}\023\355wn\030\363M2\260YD\270\r\271\232d\r\222=@\006CI\235\273\023\302A=\304D\247\216l\001\242\027O&\330z\263\344\203V/+\203\016\233\313ykOv\200N\243\372\204\0168\002~\017\341\265\v]O\300r\266Y2a\324\3033O\366\000=2\023\340\037\363A\220b\001\343x\231P<\262\256\233\344@2\254/\326\311\371\024\266\312\343\316\305\263$\233\367=\376\342{\271\216\337,\030\'\305|\341J\006\305\371C\300\206\\\320\354\363\223U\221\275\261\037ak\246\230\264b\247`U\242\233\201\212G\360e]t\330\352\361\315\020\022\332h\350\226\"O\337$c\241n\002U\344\016\257>yQ\325\312\344\034\315jC\316\340\227\324\315\301\236e\302^\376UR\305)\374\201\030\256T`,j8\245\334#\260\311*z\311\"^n\341\313\373\375\322\221\220\346N\220C\311\356A\277\227\253!\366\354[\235\320\231\371\207\246\"\311\226\335W\357l\244\354\351\020W\215\376\220g\263\033\035\314\307\321\265\272.\374\226\023Y)\231\214}a\341b3\203\205c\233\351\215\222_\r\300\260y\nE\304\362\330\335\257u\254\273\033\340\343\"\236\203:\246\223NF\216f\327t;\033X\312\v\275\342\024\375\362\330E\227n(\371&#\270I\2165\373\210v\262V\201\3750\0353;\315\215GX\354\246\023*\253l<\3265^\272C!qoM@5t\236\005\221\006\a4Z\236\t\351\237\376\374\215\327v\036t\3055g\323\371\344:g\374\005\301\340\216\326\370C\337or\251G\201\340\212o6\255\246\213\260\021\263r\320~,\026\a\177\207\246\003|\371V\336\001\341j\266M!H\374\263Q\236\345\330\2262\331\\\206/\236\340=~\345\377}\241\270\003\t\366\364\217\333g\210~\366{\024\222\255\333\240\327\323Z\333\350r]\263\215Q\252bt\213\001\004\203\375\213\234\373\025\026\v*+\316\252?\n\354!\340\325\205?\263\033y\273\006\002q\345\326gW>\ah\300#\333I2\301b\251`X\bcw\351\214\a\205w\322B\357\245*\275_\241\033g\026P\\\017\036E\250\0303r\'4l\300\235\300\255\240\325\310\240,e\316\261e\206\254\323+X\317OLt\342a\266\234D.\247\367Y\224#W/\325\322f\351C\3457gW\216lgb\177\021\232\"5\262a\031=\222\250O\221n\340\323n\300\000\223\370j\302\'M\226\245\243\243\031M;\350`\346<\251R\300f\273\257q\361\017]\375(\337.\n\033\373\265c(:\216l\252\221\037\231\235\267NI\313\303P\266\025\312\316yn\225c\354\223\221-X,T\000<\366\361\227\033.X\307\346\263:\237I\006P\276\023y\n\035t\225\264s\330F\214\253L\031\312-6\336HB\344J\214&\342\237\225\363i\001\004\202[_\334&1^\261\232\277\227\213G\344i\031k\221u\320\206\331h\376\362\314\252{\205\353D\376\f\2258\325\320\305W\a1\312\032\202\036\245\v\a1\241\377\r\263\362\364\274\300=\253\" \244]\r\"=\r\254\251qn\034!\371\250\273\203N\2028\267-l@\025\356v\317\321Lr\223\256B\344\026\222\307\2226\231\220j\342Pz\372\203r\2533\326Y\261\350\302\346D\023H\267n\3066\263\266%\250~M\276\333\266\314\237\366\004:\247\366\206\343\243\004\216\032\001\241\270\357\\S\240\200\b{\367\004\230\323\320--\241|RP4\265R\203\262\035\352]\241\341x\324\262#z\"\256%luM\"A`I\340C\245\370\210\211\250\333\360\215\255\251\320\244\3231\025\256\000~\317\235\320\003H\255|u\253\036p\334\335\321\002cT@\336\366\211u\3736\271Ah^$\304D\177\311\306\361_m\335\253\234\370\344\202P\331\031\020\023\260\377\027\376O\211>\004\215,F\305\356\021\212\031\223\310z\300\226\366:\360\a\026\317v.\222J\225\360\245\aw%!\a\351x\212\311\347-\244\257t\0027\033\222hR\347\351\344\306\004\025\224s\314\256\274\357\334\223\353\356\246E8\036\352}\017\377Ov\036&\337\357 CV\021\3123\374\253\\\204?\215\021e\321$\334\025\322\017\3428\300\212\200[\353\220\307J\247\324\215\347\220\337\244F\252\215z\276\351\242\333\233\372\362\215\327dB\273\005u\355$,\274\375AR9)=\006\237\222\211\376(f\331\373\220\273al@\250Q\227\262W\3769y\246\226\321\303\233\205\326\345\203\037\207\275sV\026\203\030d\337\315\277."
