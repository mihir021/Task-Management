      thinking_signature: "\022\366\004\n\363\004\001i\024}\023?M\226\032\201\'\306v\'];\347\201\260\341b\325\246?\022\325\3452\3427\023\306\360\037\254\262z\317xb\021z\302r\334\343Wr\206\210vlc\204\371\004(:S\nX\2431=\215\325\311\202\212\371\005F\260fFH\253OV\212o{%n\036\235\026\314\205\325\213\021\335\201\204Kqvw\360\a\021\310\022\363\376-$-\223V\211\210\253\364Aa\367P\216\025\206h3U\376W\250\203\205\300n\311\3665\\\245\262>\363\bT\316b\376K#\316\364-m\202q\265\314/\031@qT\257e\031\355\340\252\260f\376,\335\273\267\2661\253q(\fgT\230Zj\335\276l\270X6\361\017W\346\364\353\027{\204Tu9\322\"\262\021[\021\023\327NL$\350\214yP\017\355\367\314\311\027!|g\204\361\311\202\264W\376I\177\016xu\377\202\224\264\005\201\363\206K\a\200\ah\037\205\210\331\352\003\276jDLe\304P\3709|\227R\311Q\306\370\343\035\f\262\212\317\024\360\300\r\033Y\256\237\367x]\214Jt\313\220\341\345\335\321\366q\213UO\236*\306)\242\376\274\342\247I\215k\365\317\330#\aMT2\370V\214_\341\363/\222\237D\216uG\306\333\377\"\215\310\006\023\354\220\253\205\213\205H\257[9\016\352n7\235\021\342\241\310\033(\000;d\234\267X\252\317\215\227aq\3031\v\273dK;{\310\360p\305;e\203\027K\353n\216\364\270Z\334u\225\a\35781yg\236\222\230\342\321\026D\363Q\237ZZX\035\t{&\343\266GfX\223\271A\364&J\360\272\240\312h\341\236\233\023,\337%\203S\264\236\316%\345\303-\3262c)\377\372a\263\322\315\207P#\351R_{/h\'8WT\232\305\'\236V\265[\332\000\356\303\313W\225\334\204\031\345\265\211\v<\256 tXaj\'\0213\005\213c\244\266\207\233x\350\366~\3603P\2133rc\026\326\024\377\026\350U\276\303\207\216\233\353\220\026w\341vOSB\347t\016\177\354\323n\214%\332e|\372t\333\361\270\233\343\250z7<\376(QN-\230\322P\025\271f\216 5\004\016?\266\225\323C\026;\253\257\006\266\377\030\310@\t<s\275\253\r\352\304\307_ox\377\v\3411\025\340|\313\255"
