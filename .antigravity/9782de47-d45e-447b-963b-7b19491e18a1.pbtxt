            lines {
              text: "        originalRequirement:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Ensure `rayjobapp` resolves the new `websiteCertificateKey` field introduced in `RAY-MIHIR-SSL-TLS-ADD-PROFILE` when generating edge proxy TLS configurations.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        actualBehavior:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'`rayjobapp` only mapped ` {{SSL_CERT_CHAIN}} ` and ignored `websiteCertificateKey`, leaving `{{WEBSITE_CERT_KEY}}` unexpanded in generated worker configs.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        expectedBehavior:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'`sslPlaceholderMapper` resolves `websiteCertificateKey` against the worker key registry and writes the resolved path.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        stepsToReproduce:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'1. Trigger job `sync_ssl_profile` with payload containing `websiteCertificateKey`.\\n2. Inspect rendered template output in worker logs.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        investigationNotes:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Traced `src/jobs/sslPlaceholderMapper.ts` and `src/templates/edgeTlsConfig.tpl`. Added key token lookup and fallback validation.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        rootCause:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'`PLACEHOLDER_TOKEN_MAP` dictionary in `sslPlaceholderMapper.ts` did not include an entry for `websiteCertificateKey`.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        approachesConsidered:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Regex string replacement vs typed AST placeholder dictionary with strict validation.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        finalSolution:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Extended `PLACEHOLDER_TOKEN_MAP` in `sslPlaceholderMapper.ts` with strict key existence validation before writing config files.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        whyChosen:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Typed dictionary prevents partial template writes if a key alias is missing.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        limitationsFollowUp:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          \'Once staging Vault token is unblocked, complete integration check and merge into `development`.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
