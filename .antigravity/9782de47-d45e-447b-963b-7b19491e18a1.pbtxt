    content: "export type TaskStatus =\n  | \'Backlog\'\n  | \'Assigned\'\n  | \'In Progress\'\n  | \'Blocked\'\n  | \'Ready for Testing\'\n  | \'In Review\'\n  | \'Done\';\n\nexport type TaskPriority = \'Low\' | \'Medium\' | \'High\' | \'Urgent\';\n\nexport type ChangeType = \'Added\' | \'Modified\' | \'Deleted\' | \'Renamed\';\n\nexport type AttachmentCategory = \'Before\' | \'After\' | \'Reference\' | \'Testing\';\n\nexport type TestType = \'Manual\' | \'Unit\' | \'Integration\' | \'Build\' | \'Lint\' | \'Other\';\n\nexport type TestStatus = \'Not Run\' | \'Passed\' | \'Failed\' | \'Blocked\' | \'Skipped\';\n\nexport type GitStageStatus =\n  | \'Not Started\'\n  | \'In Progress\'\n  | \'Completed\'\n  | \'Blocked\'\n  | \'Not Applicable\';\n\nexport type GitStageCategory = \'local\' | \'commit\' | \'push\' | \'merge\' | \'deploy\';\n\nexport type WorkflowMode = \'PR-Based\' | \'Direct Merge\';\n\nexport interface GitWorkflowStage {\n  id: string;\n  stageKey: string;\n  stepNumber: number;\n  label: string;\n  category: GitStageCategory;\n  status: GitStageStatus;\n  completedAt: string | null;\n  notes: string;\n  sourceBranch: string;\n  targetBranch: string;\n  referenceValue: string; // commit hash, PR URL, or deployment URL\n  referenceType: \'commit\' | \'pr\' | \'deployment\' | \'branch\' | \'none\';\n  recordingMode: \'Manual\' | \'Integration\';\n  notApplicableReason: string;\n}\n\nexport interface TaskRepository {\n  id: string;\n  repositoryId: string;\n  repositoryName: string;\n  remoteUrl: string;\n  localFolderPath: string;\n  baseBranch: string;\n  workingBranch: string;\n  devTargetBranch: string;\n  cloudTargetName: string;\n  workflowMode: WorkflowMode;\n  stages: GitWorkflowStage[];\n}\n\nexport interface TaskInvestigation {\n  originalRequirement: string;\n  actualBehavior: string;\n  expectedBehavior: string;\n  stepsToReproduce: string;\n  investigationNotes: string;\n  rootCause: string;\n  approachesConsidered: string;\n  finalSolution: string;\n  whyChosen: string;\n  limitationsFollowUp: string;\n}\n\nexport interface TaskFileChange {\n  id: string;\n  repositoryName: string;\n  filePath: string;\n  changeType: ChangeType;\n  whatChanged: string;\n  whyChanged: string;\n  solutionContribution: string;\n  codeSnippet: string;\n  relatedCommit: string;\n  testingNotes: string;\n  createdAt: string;\n}\n\nexport interface TaskAttachment {\n  id: string;\n  fileName: string;\n  originalName: string;\n  mimeType: string;\n  sizeBytes: number;\n  url: string;\n  category: AttachmentCategory;\n  caption: string;\n  notes: string;\n  linkedFileChangeId: string | null;\n  linkedTestId: string | null;\n  uploadedAt: string;\n}\n\nexport interface TaskTestRecord {\n  id: string;\n  title: string;\n  testType: TestType;\n  commandOrSteps: string;\n  expectedResult: string;\n  actualResult: string;\n  status: TestStatus;\n  testedAt: string;\n  relatedAttachmentId: string | null;\n  logs: string;\n  blockedOrSkippedReason: string;\n}\n\nexport interface TimeEntry {\n  id: string;\n  taskId: string;\n  taskCode: string;\n  taskTitle: string;\n  startedAt: string;\n  endedAt: string | null;\n  durationMinutes: number;\n  notes: string;\n  isManual: boolean;\n}\n\nexport interface ActivityItem {\n  id: string;\n  taskId: string | null;\n  taskCode: string | null;\n  actionType: \'status\' | \'note\' | \'file\' | \'attachment\' | \'test\' | \'git\' | \'timer\' | \'system\';\n  summary: string;\n  details: string;\n  timestamp: string;\n}\n\nexport interface WorkNote {\n  id: string;\n  taskId: string | null;\n  taskCode: string | null;\n  title: string;\n  content: string;\n  tags: string[];\n  createdAt: string;\n}\n\nexport interface TaskChecklistItem {\n  id: string;\n  title: string;\n  completed: boolean;\n}\n\nexport interface TaskRecord {\n  id: string;\n  taskCode: string; // e.g., MIHIR-001\n  title: string;\n  description: string;"
