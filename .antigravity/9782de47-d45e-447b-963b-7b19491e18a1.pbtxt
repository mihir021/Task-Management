            lines {
              text: "      description:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'[Illustrative Sample Record] Optimize graph loading in raydashboard and batch timeseries queries in rayhubapp so switching time ranges (1h / 6h / 24h) does not trigger redundant full-board refetches.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ticketUrl: \'https://ray.internal/browse/RAY-1405\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
