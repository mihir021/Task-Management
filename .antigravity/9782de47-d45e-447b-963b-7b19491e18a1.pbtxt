      arguments_json: "{\"CodeContent\":\"# Port for the MIHIR Workspace Express + Vite server\\nPORT=3000\\n\\n# Optional override for data directory (defaults to ./MIHIR/data and ./MIHIR/uploads)\\nMIHIR_DATA_DIR=\\\"./MIHIR/data\\\"\\nMIHIR_UPLOADS_DIR=\\\"./MIHIR/uploads\\\"\\n\", \"Description\":\"Create example environment configuration in MIHIR/.env.example\", \"Overwrite\":true, \"TargetFile\":\"/MIHIR/.env.example\", \"toolAction\":\"Creating MIHIR/.env.example\", \"toolSummary\":\"Create MIHIR/.env.example\"}"
