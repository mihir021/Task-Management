      thinking_signature: "\022\275\r\n\272\r\001i\024}\023K\347\377\210\266m#\307\201\217f\t\333\266a\001C+tM\376\r2\336\341\316(\204j\316K\340Q\345\373\033\v\333\215;t\335\307\347\325\244\350\372\250\246\330(\217\214s\206\271\246\317\006\271\357s\220\361\254\371H\315\310\b\201\371\231\302t\023\371\232\346\262\213\263Jc\n\027\215\231,MZ_|>\022\322\235\t\236\371 Rmw,VK\264\0351@+o\223`,B\200&\"\t\rHd=\363\252\bN\254\235}.\275fs\221U5j\241\001\213!\247\263\267\245f\001\024\337gl\317\356\271\'P$h\345pw\023\374c\023\t\372\aO\034\234\210*3a\366\235\360`\354qa\247\204H\313\362\251\337\233\020\206\207\021!\177\370V\356J\260\255R^\344h\355\273\345\020q\360\365\201\000\307\315e\004\254L\336\223m\327Id(\311W\370\331w\346}z\016y\026\354\035d\213$\333\373\374y\253R\375\321\362S\342o\341p\214\247{\210\320\fI\211\373\324\211\206\v\343\212\034\337P\314\257\024\272\204[\337-\32417\265V\220%\\\262\302\025H(\344\"T\354\016;k\003\001\307\241\0270\255k,\200\305q*\363\307\2509\037W]\311\332\027\303\333n\230?\360\323;M\377\201\266\225\363W\034\257\356\236\232\234({po\270\333\242\333\255\331\315q\324\a\252CV\220u\017\326Z\361<\276t\025\002\005\244F\204\321\"\336\240\006/\266\033\027\315\232\f\263eI\230\025*~=\336\255\3411\003T\264:\203\317\030\022\342}\022OaX\266\342\022\024\001\372\324l~=\004\"=\313)i\304\220#u\251\037\346\310\3259\342\\0i\r4\375 \231:\027\340=\b\027\342|\200\227,\235\277\303\312\232\312\210;\245\3213\264\342\031\235\357\332\003\365X\2444\256\000\274\254n\201\332\255\205Ae\225j\327\023gf\322\363\302\275WF,_\362\036(\331\305\242\aB\223\363\372\200\312$\244\255\317\'\027k\304\235\305\207\260T\303rd\035\364W\242\271,|$\230\370\221F,0\217P\321\345\000\035\322\a\277\334\336N\377\2117\304\301X\321L],y\335\003\317\350\241\210\016\2631\264\301\320\213\370[\\\340\205~\'\370\3025\210\f\t.B\305t\226:fAF\327\026\001\302\234\227Ho\306\276-L\'\272\234\316k\250N1V\364\273W\311\n\0375!4\231eiKZ\242\337\034\267\206\267\230{2\353\234,\345\017\261\016\210Q\023E46n-\"\\ZbO\250\253\301[8I\3