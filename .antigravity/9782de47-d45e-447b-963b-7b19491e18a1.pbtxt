    content: "import express from \'express\';\nimport fs from \'node:fs\';\nimport path from \'node:path\';\nimport {\n  createCompleteBackupBundle,\n  deleteProjectById,\n  deleteRepositoryById,\n  deleteTaskById,\n  deleteTimeEntryById,\n  deleteWorkNoteById,\n  getAllRepositories,\n  getFullWorkspaceState,\n  getNextTaskCode,\n  getSettings,\n  getTaskById,\n  logActivity,\n  removeDemoData,\n  restoreDemoData,\n  restoreFromBackupBundle,\n  saveSettings,\n  UPLOADS_DIR,\n  upsertProject,\n  upsertRepository,\n  upsertTask,\n  upsertTimeEntry,\n  upsertWorkNote,\n} from \'./db\';\nimport { createDefaultGitStages } from \'../src/lib/workspaceLogic\';\nimport { DuplicatePolicy, TaskAttachment, TaskRecord, TaskRepository } from \'../src/types/workspace\';\n\nexport const apiRouter = express.Router();\n\nconst ALLOWED_MIME_TYPES = new Set([\n  \'image/png\',\n  \'image/jpeg\',\n  \'image/jpg\',\n  \'image/webp\',\n  \'image/gif\',\n  \'image/svg+xml\',\n  \'application/pdf\',\n  \'text/plain\',\n  \'application/json\',\n]);\n\napiRouter.get(\'/workspace\', (_req, res) => {\n  try {\n    res.json(getFullWorkspaceState());\n  } catch (err: any) {\n    res.status(500).json({ error: err?.message || \'Failed to load workspace state\' });\n  }\n});\n\napiRouter.post(\'/tasks\', (req, res) => {\n  try {\n    const body = req.body as Partial<TaskRecord> & {\n      selectedRepoConfigs?: Array<{\n        repositoryId: string;\n        workingBranch?: string;\n        baseBranch?: string;\n        devTargetBranch?: string;"
