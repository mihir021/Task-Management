  view_file {
    absolute_path_uri: "file:///MIHIR/src/components/TaskListView.tsx"
    end_line: 84
    content: "import React, { useMemo, useState } from \'react\';\nimport {\n  Search,\n  LayoutGrid,\n  Table as TableIcon,\n  Plus,\n  Copy,\n  Archive,\n  ArchiveRestore,\n  GitBranch,\n  ArrowUpDown,\n  Trash2,\n  ListChecks,\n  Check,\n  ChevronDown,\n  ChevronUp,\n  GripVertical,\n} from \'lucide-react\';\nimport {\n  ProjectConfig,\n  RepositoryConfig,\n  TaskPriority,\n  TaskRecord,\n  TaskStatus,\n} from \'../types/workspace\';\nimport {\n  BOARD_WORKFLOW_COLUMNS,\n  BoardWorkflowColumnId,\n  filterAndSortTasks,\n  formatUnambiguousDate,\n  groupTasksByBoardColumn,\n  mapStatusToBoardColumn,\n  resolveStatusFromBoardColumnDrop,\n  summarizeRepositoryProgress,\n  summarizeTaskChecklistProgress,\n} from \'../lib/workspaceLogic\';\n\nconst ALL_STATUSES: TaskStatus[] = [\n  \'Backlog\',\n  \'Assigned\',\n  \'In Progress\',\n  \'Blocked\',\n  \'Ready for Testing\',\n  \'In Review\',\n  \'Done\',\n];\n\ninterface TaskListViewProps {\n  tasks: TaskRecord[];\n  projects: ProjectConfig[];\n  repositories: RepositoryConfig[];\n  availableTags: string[];\n  timezone: string;\n  initialStatusFilter?: string;\n  initialRepoFilter?: string;\n  globalSearchQuery: string;\n  onOpenTask: (taskId: string) => void;\n  onOpenNewTask: () => void;\n  onUpdateTaskStatus: (taskId: string, status: TaskStatus) => Promise<void>;\n  onToggleSubtask?: (taskId: string, subtaskId: string) => Promise<void>;\n  onToggleArchiveTask: (taskId: string, archive: boolean) => Promise<void>;\n  onDuplicateTask: (taskId: string) => Promise<void>;\n  onDeleteTask: (taskId: string) => Promise<void>;\n}\n\nexport const TaskListView: React.FC<TaskListViewProps> = ({\n  tasks,\n  projects,\n  repositories,\n  availableTags,\n  timezone,\n  initialStatusFilter = \'All\',\n  initialRepoFilter = \'All\',\n  globalSearchQuery,\n  onOpenTask,\n  onOpenNewTask,\n  onUpdateTaskStatus,\n  onToggleSubtask,\n  onToggleArchiveTask,\n  onDuplicateTask,\n  onDeleteTask,\n}) => {\n  const [viewMode, setViewMode] = useState<\'table\' | \'kanban\'>(\'table\');\n  const [boardLayoutMode, setBoardLayoutMode] = useState<\'workflow4\' | \'detailed7\'>(\'workflow4\');\n  const [draggedTaskId, setDraggedTaskId] = useState<string | null>(null);"
    num_lines: 1255
