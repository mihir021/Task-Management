  code_action {
    action_spec {
      command {
        instruction: "Update NewTaskModal.tsx so Task ID is auto-assigned and synced via useEffect, add inline \'+ Add Repo / Custom Folder\' form, remove localFolderPath display, and remove Dev Target branch leaving only Base Branch and Working Branch."
        is_edit: true
        file {
