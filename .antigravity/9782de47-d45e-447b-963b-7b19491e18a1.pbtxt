        target_content: "export function upsertTask(task: TaskRecord): TaskRecord {\n  const now = new Date().toISOString();\n  const updated: TaskRecord = {\n    ...task,\n    updatedAt: now,\n  };\n  db.prepare(`\n    INSERT OR REPLACE INTO tasks (id, task_code, status, priority, project_name, is_archived, is_demo, updated_at, data_json)\n    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\n  `).run(\n    updated.id,\n    updated.taskCode,\n    updated.status,\n    updated.priority,\n    updated.projectName,\n    updated.isArchived ? 1 : 0,\n    updated.isDemo ? 1 : 0,\n    updated.updatedAt,\n    JSON.stringify(updated)\n  );\n  return updated;\n}\n\nexport function deleteTaskById(id: string): void {"
        replacement_content: "export function upsertTask(task: TaskRecord): TaskRecord {\n  const now = new Date().toISOString();\n  const updated: TaskRecord = {\n    ...task,\n    updatedAt: now,\n  };\n  db.prepare(`\n    INSERT OR REPLACE INTO tasks (id, task_code, status, priority, project_name, is_archived, is_demo, updated_at, data_json)\n    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\n  `).run(\n    updated.id,\n    updated.taskCode,\n    updated.status,\n    updated.priority,\n    updated.projectName,\n    updated.isArchived ? 1 : 0,\n    updated.isDemo ? 1 : 0,\n    updated.updatedAt,\n    JSON.stringify(updated)\n  );\n  return updated;\n}\n\nexport function reorderTasksInColumn(\n  orderedTaskIds: string[],\n  statusUpdates?: Record<string, TaskRecord[\'status\']>\n): TaskRecord[] {\n  const now = new Date().toISOString();\n  const updatedTasks: TaskRecord[] = [];\n  const stmt = db.prepare(`\n    INSERT OR REPLACE INTO tasks (id, task_code, status, priority, project_name, is_archived, is_demo, updated_at, data_json)\n    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\n  `);\n\n  orderedTaskIds.forEach((taskId, index) => {\n    const existing = getTaskById(taskId);\n    if (!existing) return;\n\n    const requestedStatus = statusUpdates?.[taskId];\n    const statusChanged = Boolean(requestedStatus && requestedStatus !== existing.status);\n    const nextStatus = requestedStatus || existing.status;\n\n    let startedAt = existing.startedAt;\n    if (nextStatus === \'In Progress\' && !startedAt) {\n      startedAt = now;\n    }\n    let completedAt = existing.completedAt;\n    if (nextStatus === \'Done\' && existing.status !== \'Done\') {\n      completedAt = now;\n    } else if (nextStatus !== \'Done\') {\n      completedAt = null;\n    }\n\n    const updated: TaskRecord = {\n      ...existing,\n      status: nextStatus,\n      startedAt,\n      completedAt,\n      boardOrder: index + 1,\n      updatedAt: statusChanged ? now : existing.updatedAt,\n    };\n\n    stmt.run(\n      updated.id,\n      updated.taskCode,\n      updated.status,\n      updated.priority,\n      updated.projectName,\n      updated.isArchived ? 1 : 0,\n      updated.isDemo ? 1 : 0,\n      updated.updatedAt,\n      JSON.stringify(updated)\n    );\n    updatedTasks.push(updated);\n  });\n\n  return updatedTasks;\n}\n\nexport function deleteTaskById(id: string): void {"
        start_line: 209
