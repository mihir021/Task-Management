          replacement_content: "import {\n  GitWorkflowStage,\n  RequiredCompletionChecks,\n  TaskChecklistItem,\n  TaskPriority,\n  TaskRecord,\n  TaskStatus,\n  TimeEntry,\n  WorkflowMode,\n} from \'../types/workspace\';"
          start_line: 1
          end_line: 10
        }
        replacement_chunks {
          target_content: "    cloudPromoted: isStrictlyCompleted(\'promote_cloud\') || isStrictlyCompleted(\'verify_cloud\'),\n    hasBlockedStage: repo.stages.some((s) => s.status === \'Blocked\'),\n  };\n}"
          replacement_content: "    cloudPromoted: isStrictlyCompleted(\'promote_cloud\') || isStrictlyCompleted(\'verify_cloud\'),\n    hasBlockedStage: repo.stages.some((s) => s.status === \'Blocked\'),\n  };\n}\n\nexport interface TaskChecklistProgressSummary {\n  hasChecklist: boolean;\n  items: TaskChecklistItem[];\n  completedCount: number;\n  totalCount: number;\n  percent: number;\n  isComplete: boolean;\n  source: \'subtasks\' | \'acceptanceCriteria\' | \'none\';\n}\n\nexport function parseAcceptanceCriteriaChecklist(\n  acceptanceCriteria: string | undefined | null,\n  defaultCompleted = false\n): TaskChecklistItem[] {\n  if (!acceptanceCriteria || !acceptanceCriteria.trim()) return [];\n  const rawLines = acceptanceCriteria\n    .split(/\\r?\\n/)\n    .map((line) => line.trim())\n    .filter(Boolean);\n\n  // Only treat as checklist if there are multiple lines or explicit list/checkbox markers\n  const listMarkerRegex = /^(?:[-*\342\200\242]\\s*\\[([ xX\342\234\223\342\234\224])\\]\\s*|\\[([ xX\342\234\223\342\234\224])\\]\\s*|(\\d+)[.)]\\s+|[-*\342\200\242]\\s+)/;\n  const hasExplicitMarkers = rawLines.some((line) => listMarkerRegex.test(line));\n  if (!hasExplicitMarkers && rawLines.length < 2) {\n    return [];\n  }\n\n  return rawLines.map((line, idx) => {\n    const checkboxMatch = line.match(/^(?:[-*\342\200\242]\\s*)?\\[([ xX\342\234\223\342\234\224])\\]\\s*(.+)$/);\n    if (checkboxMatch) {\n      const mark = checkboxMatch[1].toLowerCase();\n      const isChecked = mark === \'x\' || mark === \'\342\234\223\' || mark === \'\342\234\224\';\n      return {\n        id: `ac-item-${idx + 1}`,\n        title: checkboxMatch[2].trim(),\n        completed: isChecked,\n      };\n    }\n\n    const cleanedTitle = line.replace(/^(?:(\\d+)[.)]\\s+|[-*\342\200\242]\\s+)/, \'\').trim();\n    return {\n      id: `ac-item-${idx + 1}`,\n      title: cleanedTitle || line,\n      completed: defaultCompleted,\n    };\n  });\n}\n\nexport function summarizeTaskChecklistProgress(task: TaskRecord): TaskChecklistProgressSummary {\n  if (Array.isArray(task.subtasks) && task.subtasks.length > 0) {\n    const items = task.subtasks.filter((item) => item && item.title.trim().length > 0);\n    const totalCount = items.length;\n    const completedCount = items.filter((item) => item.completed).length;\n    const percent = totalCount > 0 ? Math.round((completedCount / totalCount) * 100) : 0;\n    return {\n      hasChecklist: totalCount > 0,\n      items,\n      completedCount,\n      totalCount,\n      percent,\n      isComplete: totalCount > 0 && completedCount === totalCount,\n      source: totalCount > 0 ? \'subtasks\' : \'none\',\n    };\n  }\n\n  const parsedItems = parseAcceptanceCriteriaChecklist(\n    task.acceptanceCriteria,\n    task.status === \'Done\'\n  );\n  if (parsedItems.length > 0) {\n    const totalCount = parsedItems.length;\n    const completedCount = parsedItems.filter((item) => item.completed).length;\n    const percent = totalCount > 0 ? Math.round((completedCount / totalCount) * 100) : 0;\n    return {\n      hasChecklist: true,\n      items: parsedItems,\n      completedCount,\n      totalCount,\n      percent,\n      isComplete: completedCount === totalCount,\n      source: \'acceptanceCriteria\',\n    };\n  }\n\n  return {\n    hasChecklist: false,\n    items: [],\n    completedCount: 0,\n    totalCount: 0,\n    percent: 0,\n    isComplete: false,\n    source: \'none\',\n  };\n}"
          start_line: 164
          end_line: 172
        }
