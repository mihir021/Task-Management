        target_content: "  const handleToggleTheme = async () => {\n    const nextTheme = currentTheme === \'dark\' ? \'light\' : \'dark\';\n    localStorage.setItem(\'mihir_theme\', nextTheme);\n    await apiRequest(\n      \'/api/settings\',\n      {\n        method: \'PUT\',\n        body: JSON.stringify({ theme: nextTheme }),\n      },\n      `Switched to ${nextTheme} theme`\n    );\n  };"
        replacement_content: "  const handleToggleTheme = async () => {\n    const nextTheme = currentTheme === \'dark\' ? \'light\' : \'dark\';\n    localStorage.setItem(\'mihir_theme\', nextTheme);\n    const root = document.documentElement;\n    if (nextTheme === \'dark\') {\n      root.classList.add(\'dark\');\n    } else {\n      root.classList.remove(\'dark\');\n    }\n    setWorkspace((prev) =>\n      prev ? { ...prev, settings: { ...prev.settings, theme: nextTheme } } : prev\n    );\n    await apiRequest(\n      \'/api/settings\',\n      {\n        method: \'PUT\',\n        body: JSON.stringify({ theme: nextTheme }),\n      },\n      `Switched to ${nextTheme} theme`\n    );\n  };"
        start_line: 138
        end_line: 160
      }
      use_global_match: true
    }
    description: "Apply theme change synchronously on click in MihirWorkspaceApp.tsx"
    diff_stats {
      additions: 9
    }
