        use_fast_apply: true
        replacement_chunks {
          target_content: "import React, { useMemo, useState } from \'react\';\nimport {\n  Search,\n  LayoutGrid,\n  Table as TableIcon,\n  Plus,\n  Copy,\n  Archive,\n  ArchiveRestore,\n  GitBranch,\n  ArrowUpDown,\n  Trash2,\n  ListChecks,\n  Check,\n  ChevronDown,\n  ChevronUp,\n} from \'lucide-react\';\nimport {\n  ProjectConfig,\n  RepositoryConfig,\n  TaskPriority,\n  TaskRecord,\n  TaskStatus,\n} from \'../types/workspace\';\nimport {\n  filterAndSortTasks,\n  formatUnambiguousDate,\n  summarizeRepositoryProgress,\n  summarizeTaskChecklistProgress,\n} from \'../lib/workspaceLogic\';\n\nconst ALL_STATUSES: TaskStatus[] = [\n  \'Backlog\',\n  \'Assigned\',\n  \'In Progress\',\n  \'Blocked\',\n  \'Ready for Testing\',\n  \'In Review\',\n  \'Done\',\n];\n\ninterface TaskListViewProps {\n  tasks: TaskRecord[];\n  projects: ProjectConfig[];\n  repositories: RepositoryConfig[];\n  availableTags: string[];\n  timezone: string;\n  initialStatusFilter?: string;\n  initialRepoFilter?: string;\n  globalSearchQuery: string;\n  onOpenTask: (taskId: string) => void;\n  onOpenNewTask: () => void;\n  onUpdateTaskStatus: (taskId: string, status: TaskStatus) => Promise<void>;\n  onToggleSubtask?: (taskId: string, subtaskId: string) => Promise<void>;\n  onToggleArchiveTask: (taskId: string, archive: boolean) => Promise<void>;\n  onDuplicateTask: (taskId: string) => Promise<void>;\n  onDeleteTask: (taskId: string) => Promise<void>;\n}\n\nexport const TaskListView: React.FC<TaskListViewProps> = ({\n  tasks,\n  projects,\n  repositories,\n  availableTags,\n  timezone,\n  initialStatusFilter = \'All\',\n  initialRepoFilter = \'All\',\n  globalSearchQuery,\n  onOpenTask,\n  onOpenNewTask,\n  onUpdateTaskStatus,\n  onToggleSubtask,\n  onToggleArchiveTask,\n  onDuplicateTask,\n  onDeleteTask,\n}) => {\n  const [viewMode, setViewMode] = useState<\'table\' | \'kanban\'>(\'table\');\n  const [localSearch, setLocalSearch] = useState(\'\');\n  const [statusFilter, setStatusFilter] = useState<TaskStatus | \'All\'>(\n    (initialStatusFilter as TaskStatus | \'All\') || \'All\'\n  );\n  const [priorityFilter, setPriorityFilter] = useState<TaskPriority | \'All\'>(\'All\');\n  const [projectFilter, setProjectFilter] = useState<string>(\'All\');\n  const [repoFilter, setRepoFilter] = useState<string>(initialRepoFilter || \'All\');\n  const [tagFilter, setTagFilter] = useState<string>(\'All\');\n  const [dateFrom, setDateFrom] = useState<string>(\'\');\n  const [dateTo, setDateTo] = useState<string>(\'\');\n  const [showArchived, setShowArchived] = useState<boolean>(false);\n  const [sortBy, setSortBy] = useState<\'updatedAt\' | \'assignedAt\' | \'dueDate\' | \'priority\'>(\'updatedAt\');\n  const [sortOrder, setSortOrder] = useState<\'asc\' | \'desc\'>(\'desc\');\n  const [confirmDeleteId, setConfirmDeleteId] = useState<string | null>(null);\n  const [expandedChecklistIds, setExpandedChecklistIds] = useState<Record<string, boolean>>({});\n\n  const toggleChecklistExpand = (taskId: string) => {\n    setExpandedChecklistIds((prev) => ({\n      ...prev,\n      [taskId]: !prev[taskId],\n    }));\n  };\n\n  const combinedSearch = [globalSearchQuery, localSearch].filter(Boolean).join(\' \').trim();\n\n  const filteredTasks = useMemo(\n    () =>\n      filterAndSortTasks(tasks, {\n        search: combinedSearch,\n        status: statusFilter,\n        priority: priorityFilter,\n        project: projectFilter,\n        repository: repoFilter,\n        tag: tagFilter,\n        dateFrom: dateFrom || undefined,\n        dateTo: dateTo || undefined,\n        showArchived,\n        sortBy,\n        sortOrder,\n      }),\n    [\n      tasks,\n      combinedSearch,\n      statusFilter,\n      priorityFilter,\n      projectFilter,\n      repoFilter,\n      tagFilter,\n      dateFrom,\n      dateTo,\n      showArchived,\n      sortBy,\n      sortOrder,\n    ]\n  );\n\n  const archivedCount = useMemo(() => tasks.filter((t) => t.isArchived).length, [tasks]);\n\n  const handleResetFilters = () => {\n    setLocalSearch(\'\');\n    setStatusFilter(\'All\');\n    setPriorityFilter(\'All\');\n    setProjectFilter(\'All\');\n    setRepoFilter(\'All\');\n    setTagFilter(\'All\');\n    setDateFrom(\'\');\n    setDateTo(\'\');\n    setShowArchived(false);\n  };\n\n  return (\n    <div className=\"space-y-5\">\n      {/* Header & View Mode Switcher */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800\">\n        <div>\n          <h1 className=\"text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100\">\n            My Tasks\n          </h1>\n          <p className=\"text-sm text-slate-600 dark:text-slate-400 mt-0.5\">\n            Search by title, ID, branch, repository, or changed file path. Task status is tracked independently of Git progress.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2.5\">\n          {/* Segmented Table / Kanban Switcher */}\n          <div\n            role=\"group\"\n            aria-label=\"Task view mode\"\n            className=\"flex items-center gap-1 p-1 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800\"\n          >\n            <button\n              type=\"button\"\n              onClick={() => setViewMode(\'table\')}\n              className={`flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap ${\n                viewMode === \'table\'\n                  ? \'bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 shadow-2xs\'\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200\'\n              }`}\n            >\n              <TableIcon className=\"w-3.5 h-3.5\" />\n              Table View\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setViewMode(\'kanban\')}\n              className={`flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap ${\n                viewMode === \'kanban\'\n                  ? \'bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 shadow-2xs\'\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200\'\n              }`}\n            >\n              <LayoutGrid className=\"w-3.5 h-3.5\" />\n              Kanban Board\n            </button>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onOpenNewTask}\n            className=\"flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-500 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            New Task\n          </button>\n        </div>\n      </div>"
          replacement_content: "import React, { useMemo, useState } from \'react\';\nimport {\n  Search,\n  LayoutGrid,\n  Table as TableIcon,\n  Plus,\n  Copy,\n  Archive,\n  ArchiveRestore,\n  GitBranch,\n  ArrowUpDown,\n  Trash2,\n  ListChecks,\n  Check,\n  ChevronDown,\n  ChevronUp,\n  GripVertical,\n} from \'lucide-react\';\nimport {\n  ProjectConfig,\n  RepositoryConfig,\n  TaskPriority,\n  TaskRecord,\n  TaskStatus,\n} from \'../types/workspace\';\nimport {\n  BOARD_WORKFLOW_COLUMNS,\n  BoardWorkflowColumnId,\n  filterAndSortTasks,\n  formatUnambiguousDate,\n  groupTasksByBoardColumn,\n  mapStatusToBoardColumn,\n  resolveStatusFromBoardColumnDrop,\n  summarizeRepositoryProgress,\n  summarizeTaskChecklistProgress,\n} from \'../lib/workspaceLogic\';\n\nconst ALL_STATUSES: TaskStatus[] = [\n  \'Backlog\',\n  \'Assigned\',\n  \'In Progress\',\n  \'Blocked\',\n  \'Ready for Testing\',\n  \'In Review\',\n  \'Done\',\n];\n\ninterface TaskListViewProps {\n  tasks: TaskRecord[];\n  projects: ProjectConfig[];\n  repositories: RepositoryConfig[];\n  availableTags: string[];\n  timezone: string;\n  initialStatusFilter?: string;\n  initialRepoFilter?: string;\n  globalSearchQuery: string;\n  onOpenTask: (taskId: string) => void;\n  onOpenNewTask: () => void;\n  onUpdateTaskStatus: (taskId: string, status: TaskStatus) => Promise<void>;\n  onToggleSubtask?: (taskId: string, subtaskId: string) => Promise<void>;\n  onToggleArchiveTask: (taskId: string, archive: boolean) => Promise<void>;\n  onDuplicateTask: (taskId: string) => Promise<void>;\n  onDeleteTask: (taskId: string) => Promise<void>;\n}\n\nexport const TaskListView: React.FC<TaskListViewProps> = ({\n  tasks,\n  projects,\n  repositories,\n  availableTags,\n  timezone,\n  initialStatusFilter = \'All\',\n  initialRepoFilter = \'All\',\n  globalSearchQuery,\n  onOpenTask,\n  onOpenNewTask,\n  onUpdateTaskStatus,\n  onToggleSubtask,\n  onToggleArchiveTask,\n  onDuplicateTask,\n  onDeleteTask,\n}) => {\n  const [viewMode, setViewMode] = useState<\'table\' | \'kanban\'>(\'table\');\n  const [boardLayoutMode, setBoardLayoutMode] = useState<\'workflow4\' | \'detailed7\'>(\'workflow4\');\n  const [draggedTaskId, setDraggedTaskId] = useState<string | null>(null);\n  const [dragOverColumnId, setDragOverColumnId] = useState<string | null>(null);\n  const [lastBoardMoveNotice, setLastBoardMoveNotice] = useState<string | null>(null);\n  const [localSearch, setLocalSearch] = useState(\'\');\n  const [statusFilter, setStatusFilter] = useState<TaskStatus | \'All\'>(\n    (initialStatusFilter as TaskStatus | \'All\') || \'All\'\n  );\n  const [priorityFilter, setPriorityFilter] = useState<TaskPriority | \'All\'>(\'All\');\n  const [projectFilter, setProjectFilter] = useState<string>(\'All\');\n  const [repoFilter, setRepoFilter] = useState<string>(initialRepoFilter || \'All\');\n  const [tagFilter, setTagFilter] = useState<string>(\'All\');\n  const [dateFrom, setDateFrom] = useState<string>(\'\');\n  const [dateTo, setDateTo] = useState<string>(\'\');\n  const [showArchived, setShowArchived] = useState<boolean>(false);\n  const [sortBy, setSortBy] = useState<\'updatedAt\' | \'assignedAt\' | \'dueDate\' | \'priority\'>(\'updatedAt\');\n  const [sortOrder, setSortOrder] = useState<\'asc\' | \'desc\'>(\'desc\');\n  const [confirmDeleteId, setConfirmDeleteId] = useState<string | null>(null);\n  const [expandedChecklistIds, setExpandedChecklistIds] = useState<Record<string, boolean>>({});\n\n  const toggleChecklistExpand = (taskId: string) => {\n    setExpandedChecklistIds((prev) => ({\n      ...prev,\n      [taskId]: !prev[taskId],\n    }));\n  };\n\n  const combinedSearch = [globalSearchQuery, localSearch].filter(Boolean).join(\' \').trim();\n\n  const filteredTasks = useMemo(\n    () =>\n      filterAndSortTasks(tasks, {\n        search: combinedSearch,\n        status: statusFilter,\n        priority: priorityFilter,\n        project: projectFilter,\n        repository: repoFilter,\n        tag: tagFilter,\n        dateFrom: dateFrom || undefined,\n        dateTo: dateTo || undefined,\n        showArchived,\n        sortBy,\n        sortOrder,\n      }),\n    [\n      tasks,\n      combinedSearch,\n      statusFilter,\n      priorityFilter,\n      projectFilter,\n      repoFilter,\n      tagFilter,\n      dateFrom,\n      dateTo,\n      showArchived,\n      sortBy,\n      sortOrder,\n    ]\n  );\n\n  const groupedBoardTasks = useMemo(\n    () => groupTasksByBoardColumn(filteredTasks),\n    [filteredTasks]\n  );\n\n  const archivedCount = useMemo(() => tasks.filter((t) => t.isArchived).length, [tasks]);\n\n  const handleResetFilters = () => {\n    setLocalSearch(\'\');\n    setStatusFilter(\'All\');\n    setPriorityFilter(\'All\');\n    setProjectFilter(\'All\');\n    setRepoFilter(\'All\');\n    setTagFilter(\'All\');\n    setDateFrom(\'\');\n    setDateTo(\'\');\n    setShowArchived(false);\n  };\n\n  const handleTaskDragStart = (e: React.DragEvent<HTMLDivElement>, taskId: string) => {\n    setDraggedTaskId(taskId);\n    e.dataTransfer.effectAllowed = \'move\';\n    e.dataTransfer.setData(\'text/plain\', taskId);\n  };\n\n  const handleTaskDragEnd = () => {\n    setDraggedTaskId(null);\n    setDragOverColumnId(null);\n  };\n\n  const handleColumnDragOver = (e: React.DragEvent<HTMLDivElement>, columnKey: string) => {\n    e.preventDefault();\n    e.dataTransfer.dropEffect = \'move\';\n    if (dragOverColumnId !== columnKey) {\n      setDragOverColumnId(columnKey);\n    }\n  };\n\n  const handleColumnDragLeave = (e: React.DragEvent<HTMLDivElement>, columnKey: string) => {\n    const relatedTarget = e.relatedTarget as Node | null;\n    if (!e.currentTarget.contains(relatedTarget)) {\n      if (dragOverColumnId === columnKey) {\n        setDragOverColumnId(null);\n      }\n    }\n  };\n\n  const handleMoveTaskToWorkflowColumn = async (\n    taskId: string,\n    targetColumnId: BoardWorkflowColumnId\n  ) => {\n    const targetTask = tasks.find((t) => t.id === taskId);\n    if (!targetTask) return;\n    const nextStatus = resolveStatusFromBoardColumnDrop(targetColumnId, targetTask.status);\n    if (nextStatus !== targetTask.status) {\n      await onUpdateTaskStatus(targetTask.id, nextStatus);\n      setLastBoardMoveNotice(\n        `Moved ${targetTask.taskCode} to ${targetColumnId} (${nextStatus})`\n      );\n    }\n  };\n\n  const handleWorkflowColumnDrop = async (\n    e: React.DragEvent<HTMLDivElement>,\n    targetColumnId: BoardWorkflowColumnId\n  ) => {\n    e.preventDefault();\n    const droppedId = e.dataTransfer.getData(\'text/plain\') || draggedTaskId;\n    setDragOverColumnId(null);\n    setDraggedTaskId(null);\n    if (!droppedId) return;\n    await handleMoveTaskToWorkflowColumn(droppedId, targetColumnId);\n  };\n\n  const handleDetailedStatusDrop = async (\n    e: React.DragEvent<HTMLDivElement>,\n    targetStatus: TaskStatus\n  ) => {\n    e.preventDefault();\n    const droppedId = e.dataTransfer.getData(\'text/plain\') || draggedTaskId;\n    setDragOverColumnId(null);\n    setDraggedTaskId(null);\n    if (!droppedId) return;\n    const targetTask = tasks.find((t) => t.id === droppedId);\n    if (!targetTask || targetTask.status === targetStatus) return;\n    await onUpdateTaskStatus(targetTask.id, targetStatus);\n    setLastBoardMoveNotice(`Moved ${targetTask.taskCode} to ${targetStatus}`);\n  };\n\n  return (\n    <div className=\"space-y-5\">\n      {/* Header & View Mode Switcher */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800\">\n        <div>\n          <h1 className=\"text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100\">\n            My Tasks\n          </h1>\n          <p className=\"text-sm text-slate-600 dark:text-slate-400 mt-0.5\">\n            Search by title, ID, branch, repository, or changed file path. Task status is tracked independently of Git progress.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2.5\">\n          {/* Segmented Table / Board Switcher */}\n          <div\n            role=\"group\"\n            aria-label=\"Task view mode\"\n            className=\"flex items-center gap-1 p-1 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800\"\n          >\n            <button\n              type=\"button\"\n              data-testid=\"view-mode-table\"\n              onClick={() => setViewMode(\'table\')}\n              className={`flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap ${\n                viewMode === \'table\'\n                  ? \'bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 shadow-2xs\'\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200\'\n              }`}\n            >\n              <TableIcon className=\"w-3.5 h-3.5\" />\n              Table View\n            </button>\n            <button\n              type=\"button\"\n              data-testid=\"view-mode-board\"\n              onClick={() => setViewMode(\'kanban\')}\n              className={`flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap ${\n                viewMode === \'kanban\'\n                  ? \'bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 shadow-2xs\'\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200\'\n              }`}\n            >\n              <LayoutGrid className=\"w-3.5 h-3.5\" />\n              Board View\n            </button>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onOpenNewTask}\n            className=\"flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-500 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            New Task\n          </button>\n        </div>\n      </div>"
          start_line: 1
