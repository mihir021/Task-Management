  \"content\",\n        \"relatedTaskCode\",\n        \"status\",\n        \"createdAt\",\n        \"updatedAt\"\n      ]\n    },\n    \"WorkspaceTimeEntry\": {\n      \"title\": \"WorkspaceTimeEntry\",\n      \"description\": \"A time log entry synced to Cloud Firestore.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"ownerId\": {\n          \"type\": \"string\",\n          \"description\": \"Firebase Auth UID of the developer.\",\n          \"minLength\": 1,\n          \"maxLength\": 128,\n          \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\"\n        },\n        \"taskCode\": {\n          \"type\": \"string\",\n          \"description\": \"Associated task code.\",\n          \"minLength\": 1,\n          \"maxLength\": 40\n        },\n        \"durationMinutes\": {\n          \"type\": \"integer\",\n          \"description\": \"Logged duration in minutes (1 to 1440).\"\n        },\n        \"notes\": {\n          \"type\": \"string\",\n          \"description\": \"Work session summary notes.\",\n          \"minLength\": 1,\n          \"maxLength\": 1000\n        },\n        \"status\": {\n          \"type\": \"string\",\n          \"description\": \"Entry status.\",\n          \"enum\": [\"Logged\", \"Locked\"],\n          \"minLength\": 1,\n          \"maxLength\": 20\n        },\n        \"createdAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\",\n          \"description\": \"Server creation timestamp.\"\n        },\n        \"updatedAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\",\n          \"description\": \"Server update timestamp.\"\n        }\n      },\n      \"required\": [\n        \"ownerId\",\n        \"taskCode\",\n        \"durationMinutes\",\n        \"notes\",\n        \"status\",\n        \"createdAt\",\n        \"updatedAt\"\n      ]\n    },\n    \"ChatThread\": {\n      \"title\": \"ChatThread\",\n      \"description\": \"A multi-turn Gemini engineering assistant conversation thread.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"ownerId\": {\n          \"type\": \"string\",\n          \"description\": \"Firebase Auth UID of the thread owner.\",\n          \"minLength\": 1,\n          \"maxLength\": 128,\n          \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\"\n        },\n        \"title\": {\n          \"type\": \"string\",\n          \"description\": \"Conversation thread title.\",\n          \"minLength\": 1,\n          \"maxLength\": 200\n        },\n        \"roleId\": {\n          \"type\": \"string\",\n          \"description\": \"Selected engineering persona role identifier.\",\n          \"minLength\": 1,\n          \"maxLength\": 60\n        },\n        \"modelId\": {\n          \"type\": \"string\",\n          \"description\": \"Selected Gemini model identifier.\",\n          \"enum\": [\n            \"gemini-4-argon\",\n            \"gemini-3.8-flash\",\n            \"gemini-3.1-flash-lite\"\n          ],\n          \"minLength\": 1,\n          \"maxLength\": 60\n        },\n        \"linkedTaskCode\": {\n          \"type\": \"string\",\n          \"description\": \"Task code attached as context or NONE.\",\n          \"minLength\": 1,\n          \"maxLength\": 40\n        },\n        \"status\": {\n          \"type\": \"string\",\n          \"description\": \"Thread status.\",\n          \"enum\": [\"Active\", \"Locked\"],\n          \"minLength\": 1,\n          \"maxLength\": 20\n        },\n        \"createdAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\",\n          \"description\": \"Server creation timestamp.\"\n        },\n        \"updatedAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\",\n          \"description\": \"Server update timestamp.\"\n        }\n      },\n      \"required\": [\n        \"ownerId\",\n        \"title\",\n        \"roleId\",\n        \"modelId\",\n        \"linkedTaskCode\",\n        \"status\",\n        \"createdAt\",\n        \"updatedAt\"\n      ]\n    },\n    \"ChatMessage\": {\n      \"title\": \"ChatMessage\",\n      \"description\": \"An individual message within a ChatThread subcollection.\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"ownerId\": {\n          \"type\": \"string\",\n          \"description\": \"Firebase Auth UID of the thread owner.\",\n          \"minLength\": 1,\n          \"maxLength\": 128,\n          \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\"\n        },\n        \"threadId\": {\n          \"type\": \"string\",\n          \"description\": \"Parent ChatThread document ID.\",\n          \"minLength\": 1,\n          \"maxLength\": 128,\n          \"pattern\": \"^[a-zA-Z0-9_\\\\-]+$\"\n        },\n        \"sender\": {\n          \"type\": \"string\",\n          \"description\": \"Message role: user or model.\",\n          \"enum\": [\"user\", \"model\"],\n          \"minLength\": 1,\n          \"maxLength\": 20\n        },\n        \"text\": {\n          \"type\": \"string\",\n          \"description\": \"Markdown message content.\",\n          \"minLength\": 1,\n          \"maxLength\": 15000\n        },\n        \"modelUsed\": {\n          \"type\": \"string\",\n          \"description\": \"Gemini model used to generate or process the turn.\",\n          \"minLength\": 1,\n          \"maxLength\": 60\n        },\n        \"status\": {\n          \"type\": \"string\",\n          \"description\": \"Message state.\",\n          \"enum\": [\"Final\", \"Locked\"],\n          \"minLength\": 1,\n          \"maxLength\": 20\n        },\n        \"createdAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\",\n          \"description\": \"Server creation timestamp.\"\n        },\n        \"updatedAt\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\",\n          \"description\": \"Server update timestamp.\"\n        }\n      },\n      \"required\": [\n        \"ownerId\",\n        \"threadId\",\n        \"sender\",\n        \"text\",\n        \"modelUsed\",\n        \"status\",\n        \"createdAt\",\n        \"updatedAt\"\n      ]\n    }\n  },\n  \"firestore\": {\n    \"/tasks/{taskId}\": {\n      \"schema\": { \"$ref\": \"#/entities/WorkspaceTask\" },\n      \"description\": \"Cloud-synced developer tasks owned by the authenticated user.\"\n    },\n    \"/workNotes/{noteId}\": {\n      \"schema\": { \"$ref\": \"#/entities/WorkspaceNote\" },\n      \"description\": \"Cloud-synced engineering notes and daily focus items.\"\n    },\n    \"/timeEntries/{entryId}\": {\n      \"schema\": { \"$ref\": \"#/entities/WorkspaceTimeEntry\" },\n      \"description\": \"Cloud-synced developer time entries.\"\n    },\n    \"/chatThreads/{threadId}\": {\n      \"schema\": { \"$ref\": \"#/entities/ChatThread\" },\n      \"description\": \"Multi-turn Gemini engineering assistant conversation threads.\"\n    },\n    \"/chatThreads/{threadId}/messages/{messageId}\": {\n      \"schema\": { \"$ref\": \"#/entities/ChatMessage\" },\n      \"description\": \"Ordered messages belonging to a specific ChatThread.\"\n    }\n  }\n}\n"
        path {
          absolute_uri: "file:///firebase-blueprint.json"
        }
        overwrite: true
      }
    }
