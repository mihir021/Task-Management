ask(repo)}\\n                      className={`px-2.5 py-1 text-xs font-mono rounded-lg border transition-colors ${\\n                        attached\\n                          ? \'bg-slate-100 dark:bg-slate-800 text-slate-400 border-slate-200 dark:border-slate-800 cursor-not-allowed\'\\n                          : \'bg-indigo-50 dark:bg-indigo-950/50 text-indigo-700 dark:text-indigo-300 border-indigo-200 dark:border-indigo-800 hover:bg-indigo-100\'\\n                      }`}\\n                    >\\n                      {attached ? `\342\234\223 ${repo.name}` : `+ ${repo.name}`}\\n                    </button>\\n                  );\\n                })}\\n              </div>\\n            </div>\\n\\n            <div className=\\\"space-y-4\\\">\\n              {task.repositories.map((repo) => (\\n                <div\\n                  key={repo.id}\\n                  className=\\\"p-3.5 rounded-lg bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 space-y-2.5 text-xs\\\"\\n                >\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <span className=\\\"font-mono font-bold text-indigo-600 dark:text-indigo-400\\\">\\n                      {repo.repositoryName}\\n                    </span>\\n                    {task.repositories.length > 1 && (\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => handleRemoveRepoFromTask(repo.id)}\\n                        className=\\\"text-[11px] text-slate-400 hover:text-red-500\\\"\\n                      >\\n                        Unlink\\n                      </button>\\n                    )}\\n                  </div>\\n\\n                  <div>\\n                    <div className=\\\"flex items-center justify-between text-[11px] text-slate-500 mb-0.5\\\">\\n                      <span>Local Workspace Path</span>\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => handleCopyText(repo.id, repo.localFolderPath)}\\n                        className=\\\"text-indigo-600 dark:text-indigo-400 flex items-center gap-0.5\\\"\\n                      >\\n                        {copiedFileKey === repo.id ? (\\n                          <>\\n                            <Check className=\\\"w-3 h-3\\\" /> Copied\\n                          </>\\n                        ) : (\\n                          <>\\n                            <Copy className=\\\"w-3 h-3\\\" /> Copy\\n                          </>\\n                        )}\\n                      </button>\\n                    </div>\\n                    <input\\n                      type=\\\"text\\\"\\n                      value={repo.localFolderPath}\\n                      onChange={(e) =>\\n                        handleUpdateRepoMeta(repo.id, \'localFolderPath\', e.target.value)\\n                      }\\n                      className=\\\"w-full px-2 py-1 text-xs font-mono rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900\\\"\\n                    />\\n                  </div>\\n\\n                  <div className=\\\"grid grid-cols-2 gap-2\\\">\\n                    <div>\\n                      <label className=\\\"block text-[11px] text-slate-500 mb-0.5\\\">Base Branch</label>\\n                      <input\\n                        type=\\\"text\\\"\\n                        value={repo.baseBranch}\\n                        onChange={(e) =>\\n                          handleUpdateRepoMeta(repo.id, \'baseBranch\', e.target.value)\\n                        }\\n                        className=\\\"w-full px-2 py-1 text-xs font-mono rounded border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900\\\"\\n                      />\\n                    </div>\\n                    <div>\\n                      <label className=\\\"block text-[11px] text-slat