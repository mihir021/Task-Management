              text: "      investigation: {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        originalRequirement:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'Eliminate UI freezes and slow loading spinners when opening the Security Graphs view or toggling the time window.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        actualBehavior:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'All 12 panels fired concurrent unbatched requests on mount and re-fired twice due to unmemoized time-range context object.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        expectedBehavior:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'Visible top-row panels load first in a single batched request; changing time window debounces by 150ms and aborts stale requests.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        stepsToReproduce:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'1. Open Network tab in DevTools on Security Graphs page.\\n2. Toggle range from 1h -> 6h -> 24h quickly.\\n3. Observe 36 overlapping requests and layout shift.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        investigationNotes:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'Profiled `useSecurityGraphData.ts` hook. Identified unstable object reference in `timeRange` prop causing double effect execution.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        rootCause:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'Unmemoized `timeRange` filter object combined with lack of `AbortController` cleanup and eager mounting of offscreen Grafana panels.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        approachesConsidered:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'1. Client-only request deduplication cache.\\n2. Client AbortController + IntersectionObserver lazy mount + batched `/api/v1/metrics/batch` handler in rayhubapp.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        finalSolution:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'Implemented `useBatchedGraphQuery` with `AbortController` and `IntersectionObserver` in `raydashboard`, paired with batch query coalescing in `rayhubapp`.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        whyChosen:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'Reduces HTTP connection contention on browser and cuts backend timeseries DB round-trips by 65%.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        limitationsFollowUp:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'Add Redis short-TTL response cache in rayhubapp for 24h historical aggregations.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
