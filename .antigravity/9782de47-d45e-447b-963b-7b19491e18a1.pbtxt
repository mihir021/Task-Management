              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const bUpd = new Date(b.updatedAt).getTime();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    return (aUpd - bUpd) * dir;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
