  view_file {
    absolute_path_uri: "file:///server.ts"
    end_line: 45
    content: "import express from \'express\';\nimport path from \'node:path\';\nimport fs from \'node:fs\';\nimport { createServer as createViteServer } from \'vite\';\nimport { apiRouter } from \'./MIHIR/server/apiRouter\';\nimport { UPLOADS_DIR } from \'./MIHIR/server/db\';\n\nasync function startServer() {\n  const app = express();\n  const PORT = Number(process.env.PORT) || 3000;\n\n  app.use(express.json({ limit: \'50mb\' }));\n  app.use(express.urlencoded({ extended: true, limit: \'50mb\' }));\n\n  // Serve persistent uploaded files from MIHIR/uploads\n  app.use(\'/uploads\', express.static(UPLOADS_DIR));\n\n  // Mount REST API\n  app.use(\'/api\', apiRouter);\n\n  const distPath = path.resolve(process.cwd(), \'dist\');\n  const isProd = process.env.NODE_ENV === \'production\' && fs.existsSync(distPath);\n\n  if (isProd) {\n    app.use(express.static(distPath));\n    app.get(\'*\', (_req, res) => {\n      res.sendFile(path.join(distPath, \'index.html\'));\n    });\n  } else {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`MIHIR Workspace server listening on http://localhost:${PORT}`);\n  });\n}\n\nstartServer().catch((err) => {\n  console.error(\'Failed to start MIHIR Workspace server:\', err);\n  process.exit(1);\n});\n"
    num_lines: 46
    num_bytes: 1323
    line_range_bytes: 1323
  }
}
