      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { TaskRecord } from \'../types/workspace\';\\n\\nexport function getNextTaskCodeFromList(tasks: TaskRecord[]): string {\\n  let maxNum = 0;\\n  for (const t of tasks) {\\n    const match = t.taskCode.match(/MIHIR-(\\\\d+)/i);\\n    if (match) {\\n      const n = parseInt(match[1], 10);\\n      if (n > maxNum) maxNum = n;\\n    }\\n  }\\n  return `MIHIR-${String(maxNum + 1).padStart(3, \'0\')}`;\\n}\\n\", \"Description\":\"Create client helper for generating next MIHIR-XXX task code in MIHIR/src/lib/taskCodeHelper.ts\", \"Overwrite\":true, \"TargetFile\":\"/MIHIR/src/lib/taskCodeHelper.ts\", \"toolAction\":\"Creating taskCodeHelper.ts\", \"toolSummary\":\"Create taskCodeHelper.ts\"}"
