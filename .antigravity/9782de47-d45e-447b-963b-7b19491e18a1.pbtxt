            lines {
              text: "function ensureDefaultRepositories() {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const existingRows = db.prepare(`SELECT data_json FROM repositories`).all() as Array<{ data_json: string }>;"
