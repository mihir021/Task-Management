      thinking_signature: "\022\221\002\n\216\002\001i\024}\023\271\324\245\326\215\245\270u\351\216\211\006>U\':\337\273\241\365\251\n\231#\256s\346\253(dbb\3527\360\321\361\353\364i\310\255~U3\2359K\253\375\213\251g\206\347\362~!F7\255\003v\001\212\310)\022\274\221?\241f\336[<~\272C\365\334k3\240#6\034\r\204%\302\001\360\031\036\354V,\322\"\246H\237BB\202\303\313:r\343\214oLO-e\254\352T\203\312\020\224/:\273\242mQ\253\200\266\324\341\352\302\277\344\304I\315z\3531\017\2016o\306@\233]\332\347[\322\311\367P54\224\247\202\301C\273\324\234\262 7\334\354w\301\224\266\372:~$\033\\\273E.\034\303\376M\310\336?\330\312Y\005.=\274\345\031&\270\255\336\301\357B\002\236\334\307g6\343\215\340[R\3634\244\fG\006\274\345N\t1\211\nb\006\307\267X\036\353\354\352\235<u3Q-2Gg\376R\376\254\237\337x\213\312\233V\372"
