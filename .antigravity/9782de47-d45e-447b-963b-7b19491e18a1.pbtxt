    tool_calls {
      id: "call_1163315"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Import and test board column mapping and drag-and-drop status resolution in workspaceLogic.test.ts\", \"EndLine\":15, \"Instruction\":\"Add imports for BOARD_WORKFLOW_COLUMNS, groupTasksByBoardColumn, mapStatusToBoardColumn, and resolveStatusFromBoardColumnDrop in workspaceLogic.test.ts\", \"ReplacementContent\":\"import {\\n  BOARD_WORKFLOW_COLUMNS,\\n  createDefaultGitStages,\\n  evaluateTaskReadiness,\\n  computeDashboardMetrics,\\n  filterAndSortTasks,\\n  formatUnambiguousDate,\\n  groupTasksByBoardColumn,\\n  mapStatusToBoardColumn,\\n  parseAcceptanceCriteriaChecklist,\\n  resolveStatusFromBoardColumnDrop,\\n  summarizeRepositoryProgress,\\n  summarizeTaskChecklistProgress,\\n} from \'./workspaceLogic\';\", \"StartLine\":3, \"TargetContent\":\"import {\\n  createDefaultGitStages,\\n  evaluateTaskReadiness,\\n  computeDashboardMetrics,\\n  filterAndSortTasks,\\n  formatUnambiguousDate,\\n  parseAcceptanceCriteriaChecklist,\\n  summarizeRepositoryProgress,\\n  summarizeTaskChecklistProgress,\\n} from \'./workspaceLogic\';\", \"TargetFile\":\"/MIHIR/src/lib/workspaceLogic.test.ts\", \"toolAction\":\"Updating imports in workspaceLogic.test.ts\", \"toolSummary\":\"Update imports in workspaceLogic.test.ts\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_1163407"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add unit tests for 4-column board grouping and drag-and-drop status transitions in workspaceLogic.test.ts\", \"EndLine\":290, \"Instruction\":\"Append unit test for mapStatusToBoardColumn, resolveStatusFromBoardColumnDrop, and groupTasksByBoardColumn\", \"ReplacementContent\":\"  const parsedNumbered = parseAcceptanceCriteriaChecklist(\\n    \'1. First check\\\\n2. Second check\',\\n    false\\n  );\\n  assert.equal(parsedNumbered.length, 2);\\n  assert.equal(parsedNumbered[0].title, \'First check\');\\n});\\n\\ntest(\'Board view maps 7 granular statuses into Todo, In Progress, Review, Done and resolves drag-and-drop transitions\', () => {\\n  assert.equal(BOARD_WORKFLOW_COLUMNS.length, 4);\\n  assert.deepEqual(\\n    BOARD_WORKFLOW_COLUMNS.map((c) => c.id),\\n    [\'Todo\', \'In Progress\', \'Review\', \'Done\']\\n  );\\n\\n  assert.equal(mapStatusToBoardColumn(\'Backlog\'), \'Todo\');\\n  assert.equal(mapStatusToBoardColumn(\'Assigned\'), \'Todo\');\\n  assert.equal(mapStatusToBoardColumn(\'In Progress\'), \'In Progress\');\\n  assert.equal(mapStatusToBoardColumn(\'Blocked\'), \'In Progress\');\\n  assert.equal(mapStatusToBoardColumn(\'Ready for Testing\'), \'Review\');\\n  assert.equal(mapStatusToBoardColumn(\'In Review\'), \'Review\');\\n  assert.equal(mapStatusToBoardColumn(\'Done\'), \'Done\');\\n\\n  // Dropping into a new column assigns that column\'s default status\\n  assert.equal(resolveStatusFromBoardColumnDrop(\'Todo\', \'In Progress\'), \'Assigned\');\\n  assert.equal(resolveStatusFromBoardColumnDrop(\'In Progress\', \'Assigned\'), \'In Progress\');\\n  assert.equal(resolveStatusFromBoardColumnDrop(\'Review\', \'In Progress\'), \'In Review\');\\n  assert.equal(resolveStatusFromBoardColumnDrop(\'Done\', \'In Review\'), \'Done\');\\n\\n  // Dropping within the same column preserves the granular status\\n  assert.equal(resolveStatusFromBoardColumnDrop(\'Todo\', \'Backlog\'), \'Backlog\');\\n  assert.equal(resolveStatusFromBoardColumnDrop(\'In Progress\', \'Blocked\'), \'Blocked\');\\n  assert.equal(resolveStatusFromBoardColumnDrop(\'Review\', \'Ready for Testing\'), \'Ready for Testing\');\\n\\n  const tasks = [\\n    createSampleTask({ id: \'t1\', taskCode: \'MIHIR-001\', status: \'Ready for Testing\' }),\\n    createSampleTask({ id: \'t2\', taskCode: \'MIHIR-002\', status: \'In Progress\' }),\\n    createSampleTask({ id: \'t3\', taskCode: \'MIHIR-003\', status: \'Assigned\' }),\\n    createSampleTask({ id: \'t4\', taskCode: \'MIHIR-004\', status: \'Done\' }),\\n  ];\\n\\n  const grouped = groupTasksByBoardColumn(tasks);\\n  assert.equal(grouped[\'Todo\'].length, 1);\\n  assert.equal(grouped[\'Todo\'][0].taskCode, \'MIHIR-003\');\\n  assert.equal(grouped[\'In Progress\'].length, 1);\\n  assert.equal(grouped[\'In Progress\'][0].taskCode, \'MIHIR-002\');\\n  assert.equal(grouped[\'Review\'].length, 1);\\n  assert.equal(grouped[\'Review\'][0].taskCode, \'MIHIR-001\');\\n  assert.equal(grouped[\'Done\'].length, 1);\\n  assert.equal(grouped[\'Done\'][0].taskCode, \'MIHIR-004\');\\n});\\n\", \"StartLine\":280, \"TargetContent\":\"  const parsedNumbered = parseAcceptanceCriteriaChecklist(\\n    \'1. First check\\\\n2. Second check\',\\n    false\\n  );\\n  assert.equal(parsedNumbered.length, 2);\\n  assert.equal(parsedNumbered[0].title, \'First check\');\\n});\", \"TargetFile\":\"/MIHIR/src/lib/workspaceLogic.test.ts\", \"toolAction\":\"Adding board view unit tests to workspaceLogic.test.ts\", \"toolSummary\":\"Add board view unit tests\", \"waitForPreviousTools\":true}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_1163851"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update TaskListView imports and state to support 4-column drag-and-drop Board View\", \"EndLine\":204, \"Instruction\":\"Add GripVertical icon, board workflow helpers, and drag-and-drop state/handlers to TaskListView.tsx\", \"ReplacementContent\":\"import React, { useMemo, useState } from \'react\';\\nimport {\\n  Search,\\n  LayoutGrid,\\n  Table as TableIcon,\\n  Plus,\\n  Copy,\\n  Archive,\\n  ArchiveRestore,\\n  GitBranch,\\n  ArrowUpDown,\\n  Trash2,\\n  ListChecks,\\n  Check,\\n  ChevronDown,\\n  ChevronUp,\\n  GripVertical,\\n} from \'lucide-react\';\\nimport {\\n  ProjectConfig,\\n  RepositoryConfig,\\n  TaskPriority,\\n  TaskRecord,\\n  TaskStatus,\\n} from \'../types/workspace\';\\nimport {\\n  BOARD_WORKFLOW_COLUMNS,\\n  BoardWorkflowColumnId,\\n  filterAndSortTasks,\\n  formatUnambiguousDate,\\n  groupTasksByBoardColumn,\\n  mapStatusToBoardColumn,\\n  resolveStatusFromBoardColumnDrop,\\n  summarizeRepositoryProgress,\\n  summarizeTaskChecklistProgress,\\n} from \'../lib/workspaceLogic\';\\n\\nconst ALL_STATUSES: TaskStatus[] = [\\n  \'Backlog\',\\n  \'Assigned\',\\n  \'In Progress\',\\n  \'Blocked\',\\n  \'Ready for Testing\',\\n  \'In Review\',\\n  \'Done\',\\n];\\n\\ninterface TaskListViewProps {\\n  tasks: TaskRecord[];\\n  projects: ProjectConfig[];\\n  repositories: RepositoryConfig[];\\n  availableTags: string[];\\n  timezone: string;\\n  initialStatusFilter?: string;\\n  initialRepoFilter?: string;\\n  globalSearchQuery: string;\\n  onOpenTask: (taskId: string) => void;\\n  onOpenNewTask: () => void;\\n  onUpdateTaskStatus: (taskId: string, status: TaskStatus) => Promise<void>;\\n  onToggleSubtask?: (taskId: string, subtaskId: string) => Promise<void>;\\n  onToggleArchiveTask: (taskId: string, archive: boolean) => Promise<void>;\\n  onDuplicateTask: (taskId: string) => Promise<void>;\\n  onDeleteTask: (taskId: string) => Promise<void>;\\n}\\n\\nexport const TaskListView: React.FC<TaskListViewProps> = ({\\n  tasks,\\n  projects,\\n  repositories,\\n  availableTags,\\n  timezone,\\n  initialStatusFilter = \'All\',\\n  initialRepoFilter = \'All\',\\n  globalSearchQuery,\\n  onOpenTask,\\n  onOpenNewTask,\\n  onUpdateTaskStatus,\\n  onToggleSubtask,\\n  onToggleArchiveTask,\\n  onDuplicateTask,\\n  onDeleteTask,\\n}) => {\\n  const [viewMode, setViewMode] = useState<\'table\' | \'kanban\'>(\'table\');\\n  const [boardLayoutMode, setBoardLayoutMode] = useState<\'workflow4\' | \'detailed7\'>(\'workflow4\');\\n  const [draggedTaskId, setDraggedTaskId] = useState<string | null>(null);\\n  const [dragOverColumnId, setDragOverColumnId] = useState<string | null>(null);\\n  const [lastBoardMoveNotice, setLastBoardMoveNotice] = useState<string | null>(null);\\n  const [localSearch, setLocalSearch] = useState(\'\');\\n  const [statusFilter, setStatusFilter] = useState<TaskStatus | \'All\'>(\\n    (initialStatusFilter as TaskStatus | \'All\') || \'All\'\\n  );\\n  const [priorityFilter, setPriorityFilter] = useState<TaskPriority | \'All\'>(\'All\');\\n  const [projectFilter, setProjectFilter] = useState<string>(\'All\');\\n  const [repoFilter, setRepoFilter] = useState<string>(initialRepoFilter || \'All\');\\n  const [tagFilter, setTagFilter] = useState<string>(\'All\');\\n  const [dateFrom, setDateFrom] = useState<string>(\'\');\\n  const [dateTo, setDateTo] = useState<string>(\'\');\\n  const [showArchived, setShowArchived] = useState<boolean>(false);\\n  const [sortBy, setSortBy] = useState<\'updatedAt\' | \'assignedAt\' | \'dueDate\' | \'priority\'>(\'updatedAt\');\\n  const [sortOrder, setSortOrder] = useState<\'asc\' | \'desc\'>(\'desc\');\\n  const [confirmDeleteId, setConfirmDeleteId] = useState<string | null>(null);\\n  const [expandedChecklistIds, setExpandedChecklistIds] = useState<Record<string, boolean>>({});\\n\\n  const toggleChecklistExpand = (taskId: string) => {\\n    setExpandedChecklistIds((prev) => ({\\n      ...prev,\\n      [taskId]: !prev[taskId],\\n    }));\\n  };\\n\\n  const combinedSearch = [globalSearchQuery, localSearch].filter(Boolean).join(\' \').trim();\\n\\n  const filteredTasks = useMemo(\\n    () =>\\n      filterAndSortTasks(tasks, {\\n        search: combinedSearch,\\n        status: statusFilter,\\n        priority: priorityFilter,\\n        project: projectFilter,\\n        repository: repoFilter,\\n        tag: tagFilter,\\n        dateFrom: dateFrom || undefined,\\n        dateTo: dateTo || undefined,\\n        showArchived,\\n        sortBy,\\n        sortOrder,\\n      }),\\n    [\\n      tasks,\\n      combinedSearch,\\n      statusFilter,\\n      priorityFilter,\\n      projectFilter,\\n      repoFilter,\\n      tagFilter,\\n      dateFrom,\\n      dateTo,\\n      showArchived,\\n      sortBy,\\n      sortOrder,\\n    ]\\n  );\\n\\n  const groupedBoardTasks = useMemo(\\n    () => groupTasksByBoardColumn(filteredTasks),\\n    [filteredTasks]\\n  );\\n\\n  const archivedCount = useMemo(() => tasks.filter((t) => t.isArchived).length, [tasks]);\\n\\n  const handleResetFilters = () => {\\n    setLocalSearch(\'\');\\n    setStatusFilter(\'All\');\\n    setPriorityFilter(\'All\');\\n    setProjectFilter(\'All\');\\n    setRepoFilter(\'All\');\\n    setTagFilter(\'All\');\\n    setDateFrom(\'\');\\n    setDateTo(\'\');\\n    setShowArchived(false);\\n  };\\n\\n  const handleTaskDragStart = (e: React.DragEvent<HTMLDivElement>, taskId: string) => {\\n    setDraggedTaskId(taskId);\\n    e.dataTransfer.effectAllowed = \'move\';\\n    e.dataTransfer.setData(\'text/plain\', taskId);\\n  };\\n\\n  const handleTaskDragEnd = () => {\\n    setDraggedTaskId(null);\\n    setDragOverColumnId(null);\\n  };\\n\\n  const handleColumnDragOver = (e: React.DragEvent<HTMLDivElement>, columnKey: string) => {\\n    e.preventDefault();\\n    e.dataTransfer.dropEffect = \'move\';\\n    if (dragOverColumnId !== columnKey) {\\n      setDragOverColumnId(columnKey);\\n    }\\n  };\\n\\n  const handleColumnDragLeave = (e: React.DragEvent<HTMLDivElement>, columnKey: string) => {\\n    const relatedTarget = e.relatedTarget as Node | null;\\n    if (!e.currentTarget.contains(relatedTarget)) {\\n      if (dragOverColumnId === columnKey) {\\n        setDragOverColumnId(null);\\n      }\\n    }\\n  };\\n\\n  const handleMoveTaskToWorkflowColumn = async (\\n    taskId: string,\\n    targetColumnId: BoardWorkflowColumnId\\n  ) => {\\n    const targetTask = tasks.find((t) => t.id === taskId);\\n    if (!targetTask) return;\\n    const nextStatus = resolveStatusFromBoardColumnDrop(targetColumnId, targetTask.status);\\n    if (nextStatus !== targetTask.status) {\\n      await onUpdateTaskStatus(targetTask.id, nextStatus);\\n      setLastBoardMoveNotice(\\n        `Moved ${targetTask.taskCode} to ${targetColumnId} (${nextStatus})`\\n      );\\n    }\\n  };\\n\\n  const handleWorkflowColumnDrop = async (\\n    e: React.DragEvent<HTMLDivElement>,\\n    targetColumnId: BoardWorkflowColumnId\\n  ) => {\\n    e.preventDefault();\\n    const droppedId = e.dataTransfer.getData(\'text/plain\') || draggedTaskId;\\n    setDragOverColumnId(null);\\n    setDraggedTaskId(null);\\n    if (!droppedId) return;\\n    await handleMoveTaskToWorkflowColumn(droppedId, targetColumnId);\\n  };\\n\\n  const handleDetailedStatusDrop = async (\\n    e: React.DragEvent<HTMLDivElement>,\\n    targetStatus: TaskStatus\\n  ) => {\\n    e.preventDefault();\\n    const droppedId = e.dataTransfer.getData(\'text/plain\') || draggedTaskId;\\n    setDragOverColumnId(null);\\n    setDraggedTaskId(null);\\n    if (!droppedId) return;\\n    const targetTask = tasks.find((t) => t.id === droppedId);\\n    if (!targetTask || targetTask.status === targetStatus) return;\\n    await onUpdateTaskStatus(targetTask.id, targetStatus);\\n    setLastBoardMoveNotice(`Moved ${targetTask.taskCode} to ${targetStatus}`);\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-5\\\">\\n      {/* Header & View Mode Switcher */}\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800\\\">\\n        <div>\\n          <h1 className=\\\"text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100\\\">\\n            My Tasks\\n          </h1>\\n          <p className=\\\"text-sm text-slate-600 dark:text-slate-400 mt-0.5\\\">\\n            Search by title, ID, branch, repository, or changed file path. Task status is tracked independently of Git progress.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex items-center gap-2.5\\\">\\n          {/* Segmented Table / Board Switcher */}\\n          <div\\n            role=\\\"group\\\"\\n            aria-label=\\\"Task view mode\\\"\\n            className=\\\"flex items-center gap-1 p-1 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800\\\"\\n          >\\n            <button\\n              type=\\\"button\\\"\\n              data-testid=\\\"view-mode-table\\\"\\n              onClick={() => setViewMode(\'table\')}\\n              className={`flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap ${\\n                viewMode === \'table\'\\n                  ? \'bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 shadow-2xs\'\\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200\'\\n              }`}\\n            >\\n              <TableIcon className=\\\"w-3.5 h-3.5\\\" />\\n              Table View\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              data-testid=\\\"view-mode-board\\\"\\n              onClick={() => setViewMode(\'kanban\')}\\n              className={`flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap ${\\n                viewMode === \'kanban\'\\n                  ? \'bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 shadow-2xs\'\\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200\'\\n              }`}\\n            >\\n              <LayoutGrid className=\\\"w-3.5 h-3.5\\\" />\\n              Board View\\n            </button>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onOpenNewTask}\\n            className=\\\"flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-500 rounded-lg transition-colors whitespace-nowrap shrink-0\\\"\\n          >\\n            <Plus className=\\\"w-4 h-4\\\" />\\n            New Task\\n          </button>\\n        </div>\\n      </div>\", \"StartLine\":1, \"TargetContent\":\"import React, { useMemo, useState } from \'react\';\\nimport {\\n  Search,\\n  LayoutGrid,\\n  Table as TableIcon,\\n  Plus,\\n  Copy,\\n  Archive,\\n  ArchiveRestore,\\n  GitBranch,\\n  ArrowUpDown,\\n  Trash2,\\n  ListChecks,\\n  Check,\\n  ChevronDown,\\n  ChevronUp,\\n} from \'lucide-react\';\\nimport {\\n  ProjectConfig,\\n  RepositoryConfig,\\n  TaskPriority,\\n  TaskRecord,\\n  TaskStatus,\\n} from \'../types/workspace\';\\nimport {\\n  filterAndSortTasks,\\n  formatUnambiguousDate,\\n  summarizeRepositoryProgress,\\n  summarizeTaskChecklistProgress,\\n} from \'../lib/workspaceLogic\';\\n\\nconst ALL_STATUSES: TaskStatus[] = [\\n  \'Backlog\',\\n  \'Assigned\',\\n  \'In Progress\',\\n  \'Blocked\',\\n  \'Ready for Testing\',\\n  \'In Review\',\\n  \'Done\',\\n];\\n\\ninterface TaskListViewProps {\\n  tasks: TaskRecord[];\\n  projects: ProjectConfig[];\\n  repositories: RepositoryConfig[];\\n  availableTags: string[];\\n  timezone: string;\\n  initialStatusFilter?: string;\\n  initialRepoFilter?: string;\\n  globalSearchQuery: string;\\n  onOpenTask: (taskId: string) => void;\\n  onOpenNewTask: () => void;\\n  onUpdateTaskStatus: (taskId: string, status: TaskStatus) => Promise<void>;\\n  onToggleSubtask?: (taskId: string, subtaskId: string) => Promise<void>;\\n  onToggleArchiveTask: (taskId: string, archive: boolean) => Promise<void>;\\n  onDuplicateTask: (taskId: string) => Promise<void>;\\n  onDeleteTask: (taskId: string) => Promise<void>;\\n}\\n\\nexport const TaskListView: React.FC<TaskListViewProps> = ({\\n  tasks,\\n  projects,\\n  repositories,\\n  availableTags,\\n  timezone,\\n  initialStatusFilter = \'All\',\\n  initialRepoFilter = \'All\',\\n  globalSearchQuery,\\n  onOpenTask,\\n  onOpenNewTask,\\n  onUpdateTaskStatus,\\n  onToggleSubtask,\\n  onToggleArchiveTask,\\n  onDuplicateTask,\\n  onDeleteTask,\\n}) => {\\n  const [viewMode, setViewMode] = useState<\'table\' | \'kanban\'>(\'table\');\\n  const [localSearch, setLocalSearch] = useState(\'\');\\n  const [statusFilter, setStatusFilter] = useState<TaskStatus | \'All\'>(\\n    (initialStatusFilter as TaskStatus | \'All\') || \'All\'\\n  );\\n  const [priorityFilter, setPriorityFilter] = useState<TaskPriority | \'All\'>(\'All\');\\n  const [projectFilter, setProjectFilter] = useState<string>(\'All\');\\n  const [repoFilter, setRepoFilter] = useState<string>(initialRepoFilter || \'All\');\\n  const [tagFilter, setTagFilter] = useState<string>(\'All\');\\n  const [dateFrom, setDateFrom] = useState<string>(\'\');\\n  const [dateTo, setDateTo] = useState<string>(\'\');\\n  const [showArchived, setShowArchived] = useState<boolean>(false);\\n  const [sortBy, setSortBy] = useState<\'updatedAt\' | \'assignedAt\' | \'dueDate\' | \'priority\'>(\'updatedAt\');\\n  const [sortOrder, setSortOrder] = useState<\'asc\' | \'desc\'>(\'desc\');\\n  const [confirmDeleteId, setConfirmDeleteId] = useState<string | null>(null);\\n  const [expandedChecklistIds, setExpandedChecklistIds] = useState<Record<string, boolean>>({});\\n\\n  const toggleChecklistExpand = (taskId: string) => {\\n    setExpandedChecklistIds((prev) => ({\\n      ...prev,\\n      [taskId]: !prev[taskId],\\n    }));\\n  };\\n\\n  const combinedSearch = [globalSearchQuery, localSearch].filter(Boolean).join(\' \').trim();\\n\\n  const filteredTasks = useMemo(\\n    () =>\\n      filterAndSortTasks(tasks, {\\n        search: combinedSearch,\\n        status: statusFilter,\\n        priority: priorityFilter,\\n        project: projectFilter,\\n        repository: repoFilter,\\n        tag: tagFilter,\\n        dateFrom: dateFrom || undefined,\\n        dateTo: dateTo || undefined,\\n        showArchived,\\n        sortBy,\\n        sortOrder,\\n      }),\\n    [\\n      tasks,\\n      combinedSearch,\\n      statusFilter,\\n      priorityFilter,\\n      projectFilter,\\n      repoFilter,\\n      tagFilter,\\n      dateFrom,\\n      dateTo,\\n      showArchived,\\n      sortBy,\\n      sortOrder,\\n    ]\\n  );\\n\\n  const archivedCount = useMemo(() => tasks.filter((t) => t.isArchived).length, [tasks]);\\n\\n  const handleResetFilters = () => {\\n    setLocalSearch(\'\');\\n    setStatusFilter(\'All\');\\n    setPriorityFilter(\'All\');\\n    setProjectFilter(\'All\');\\n    setRepoFilter(\'All\');\\n    setTagFilter(\'All\');\\n    setDateFrom(\'\');\\n    setDateTo(\'\');\\n    setShowArchived(false);\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-5\\\">\\n      {/* Header & View Mode Switcher */}\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800\\\">\\n        <div>\\n          <h1 className=\\\"text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100\\\">\\n            My Tasks\\n          </h1>\\n          <p className=\\\"text-sm text-slate-600 dark:text-slate-400 mt-0.5\\\">\\n            Search by title, ID, branch, repository, or changed file path. Task status is tracked independently of Git progress.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex items-center gap-2.5\\\">\\n          {/* Segmented Table / Kanban Switcher */}\\n          <div\\n            role=\\\"group\\\"\\n            aria-label=\\\"Task view mode\\\"\\n            className=\\\"flex items-center gap-1 p-1 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800\\\"\\n          >\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setViewMode(\'table\')}\\n              className={`flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap ${\\n                viewMode === \'table\'\\n                  ? \'bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 shadow-2xs\'\\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200\'\\n              }`}\\n            >\\n              <TableIcon className=\\\"w-3.5 h-3.5\\\" />\\n              Table View\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setViewMode(\'kanban\')}\\n              className={`flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap ${\\n                viewMode === \'kanban\'\\n                  ? \'bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 shadow-2xs\'\\n                  : \'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200\'\\n              }`}\\n            >\\n              <LayoutGrid className=\\\"w-3.5 h-3.5\\\" />\\n              Kanban Board\\n            </button>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onOpenNewTask}\\n            className=\\\"flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-500 rounded-lg transition-colors whitespace-nowrap shrink-0\\\"\\n          >\\n            <Plus className=\\\"w-4 h-4\\\" />\\n            New Task\\n          </button>\\n        </div>\\n      </div>\", \"TargetFile\":\"