              text: "          \'Security operations requested promoting WAF Blocked Threat Vectors and TLS Handshake Failure panels to the top row of the Security Overview Grafana board.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        actualBehavior:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
