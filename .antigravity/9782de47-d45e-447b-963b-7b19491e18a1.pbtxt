            lines {
              text: "      investigation: {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        originalRequirement:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'Provide a \"Website certificate key\" dropdown in the SSL/TLS Add/Edit Profile dialog so admins can bind a certificate key alias without syntax errors.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        actualBehavior:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'The Add Profile form lacked a structured selector for the Website certificate key, causing mismatches with downstream worker placeholders.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        expectedBehavior:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'Dropdown fetches registered key aliases from rayhubapp and stores the canonical placeholder token (e.g. `{{CERT_KEY_RAY_EDGE_RSA4096}}`).\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        stepsToReproduce:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'1. Go to Security -> SSL/TLS Profiles -> Add Profile.\\n2. Observe missing Website certificate key selector.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        investigationNotes:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'Checked `SslTlsProfileModal.tsx` in `raydashboard` and `sslProfileSchema.ts` in `rayhubapp`. Added field `websiteCertificateKey` to both form state and API payload.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        rootCause:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'When SSL/TLS profile creation was originally built, only the public certificate chain field was included in the modal schema.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        approachesConsidered:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'Static client enum vs dynamic API-driven key catalog from `rayhubapp`.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        finalSolution:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'Added `/api/v1/ssl/certificate-keys` in `rayhubapp` and wired an accessible `<select>` dropdown with search/filter support in `SslTlsProfileModal.tsx`.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        whyChosen:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'Dynamic catalog ensures newly rotated keys appear without a frontend rebuild.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        limitationsFollowUp:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          \'Coordinate placeholder expansion in `rayjobapp` (tracked in MIHIR-004).\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
