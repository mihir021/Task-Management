      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add Terminal Git Commands generator and copy helper in TaskGitWorkflowSection.tsx\", \"EndLine\":396, \"Instruction\":\"Add Terminal Git Commands snippet and Copy Commands button in TaskGitWorkflowSection.tsx\", \"ReplacementContent\":\"      {/* Repository Path & Branch Metadata Bar */}\\n      <div className=\\\"p-4 rounded-xl bg-slate-100/80 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-3 text-xs\\\">\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-3\\\">\\n          <div className=\\\"flex flex-wrap items-center gap-2 font-mono\\\">\\n            <span className=\\\"text-slate-500\\\">Local Folder:</span>\\n            <code className=\\\"px-2 py-0.5 rounded bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-slate-200\\\">\\n              {activeRepo.localFolderPath || \'/Users/mihir/workspace/ray/\' + activeRepo.repositoryName}\\n            </code>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() =>\\n                handleCopyPath(\\n                  activeRepo.localFolderPath ||\\n                    \'/Users/mihir/workspace/ray/\' + activeRepo.repositoryName\\n                )\\n              }\\n              className=\\\"inline-flex items-center gap-1 px-2 py-0.5 rounded bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-50\\\"\\n            >\\n              {copiedPath ? <Check className=\\\"w-3 h-3 text-emerald-500\\\" /> : <Copy className=\\\"w-3 h-3\\\" />}\\n              {copiedPath ? \'Copied\' : \'Copy Path\'}\\n            </button>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-3 font-mono text-slate-500\\\">\\n            <span>\\n              Base: <span className=\\\"text-slate-800 dark:text-slate-200\\\">{activeRepo.baseBranch}</span> \342\206\222 Working:{\' \'}\\n              <span className=\\\"text-indigo-600 dark:text-indigo-400\\\">{activeRepo.workingBranch}</span> \342\206\222 Dev:{\' \'}\\n              <span className=\\\"text-slate-800 dark:text-slate-200\\\">{activeRepo.devTargetBranch}</span>\\n            </span>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                const folder =\\n                  activeRepo.localFolderPath ||\\n                  `/Users/mihir/workspace/ray/${activeRepo.repositoryName}`;\\n                const cmds = [\\n                  `cd ${folder}`,\\n                  `git checkout ${activeRepo.baseBranch} && git pull origin ${activeRepo.baseBranch}`,\\n                  `git checkout -B ${activeRepo.workingBranch}`,\\n                  `git add . && git commit -m \\\"${task.taskCode}: ${task.title}\\\"`,\\n                  `git push -u origin ${activeRepo.workingBranch}`,\\n                ].join(\'\\\\n\');\\n                navigator.clipboard.writeText(cmds);\\n                setCopiedPath(true);\\n                setTimeout(() => setCopiedPath(false), 2000);\\n              }}\\n              className=\\\"inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-indigo-600 text-white font-sans font-medium hover:bg-indigo-500 transition-colors\\\"\\n            >\\n              <Copy className=\\\"w-3 h-3\\\" />\\n              Copy Terminal Git Commands\\n            </button>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* 14-Stage Interactive Stepper */}\", \"StartLine\":366, \"TargetContent\":\"      {/* Repository Path & Branch Metadata Bar */}\\n      <div className=\\\"p-4 rounded-xl bg-slate-100/80 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs\\\">\\n        <div className=\\\"flex flex-wrap items-center gap-2 font-mono\\\">\\n          <span className=\\\"text-slate-500\\\">Local