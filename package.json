{
  "name": "mihir-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "workspace": "node scripts/workspace.mjs",
    "test:workspace-client": "node --test scripts/workspace.test.mjs",
    "test:serverless": "node --test scripts/serverless.test.mjs",
    "test:monitor": "tsx --test MIHIR/server/monitor.test.ts",
    "test:scripts": "tsx --test MIHIR/server/scripts.test.ts",
    "test:log-table": "tsx --test MIHIR/src/lib/scriptLogParser.test.ts",
    "test:script-windows": "tsx --test MIHIR/src/lib/scriptWindows.test.ts",
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "vercel-build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test MIHIR/src/lib/workspaceLogic.test.ts MIHIR/src/lib/taskRepositoryDraft.test.ts",
    "terminal:runner": "tsx MIHIR/server/localRunner.ts",
    "test:terminal-runner": "tsx --test MIHIR/server/localRunner.test.ts",
    "test:auth": "tsx --test MIHIR/server/workspaceAuth.test.ts",
    "test:database": "tsx --test MIHIR/server/db.test.ts MIHIR/server/database.test.ts MIHIR/server/apiRouter.test.ts",
    "test:inventory": "tsx --test MIHIR/server/kubernetesInventory.test.ts MIHIR/src/lib/inventoryPolling.test.ts",
    "fan": "vite --host 127.0.0.1 --port 43125"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^10.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
