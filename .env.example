# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Jenkins Monitor: server-side only. Use an account with read access to jobs/logs.
JENKINS_URL="http://192.168.110.129:8080"
JENKINS_USER=""
JENKINS_API_TOKEN=""

# Hosted persistent workspace storage (server-side only; never prefix with VITE_)
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required on Vercel: at least 32 characters, shared across instances.
WORKSPACE_SESSION_SECRET=""
# Optional server-side SHA-256 password override; default matches the requested workspace password.
WORKSPACE_PASSWORD_SHA256=""
# Local SQLite remains the default; opt in explicitly to use the same cloud database locally.
MIHIR_USE_CLOUD_DB=false
